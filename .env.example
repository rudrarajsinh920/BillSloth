# BillSloth Environment Configuration (Example)
# Copy this file to .env and fill in your actual credentials.
# NOTE: Never commit your real .env file or API keys to version control.

# Backend Server Port
PORT=3001

# Google AI Studio / Gemini API Key for Gemma Inference
# Obtain a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_google_api_key_here

# Configurable Gemma Model Identifier
# Supported verified models: gemma-4-26b-a4b-it, gemma-4-31b-it
AI_MODEL=gemma-4-26b-a4b-it
